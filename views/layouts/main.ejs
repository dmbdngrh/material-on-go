<!DOCTYPE html>
<html lang="id">

<head>
  <meta charset="UTF-8">
  <title><%- typeof title !=='undefined' ? title : 'Material-on-Go' %></title>

  <!-- Google Font: Plus Jakarta Sans -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
    rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <nav>
    <div class="nav-wrapper">
      <div class="nav-brand"><a href="/dashboard">Material-on-Go</a></div>
      <div class="btn-container">
        <% if (user) { %>
          <% if (user.profile) { %>
            <a href="/profile" class="nav-profile">
              <img src="<%= user.profilePicture %>" alt="Profile" class="profile-img">
              <span>
                <%= user.name %>
              </span>
            </a>
            <% } %>
              <form action="/logout" method="post">
                <input class="btn-logout" type="submit" value="Logout">
              </form>
              <% } %>
      </div>

    </div>
  </nav>


  <%- body %>

    </body>

</html>