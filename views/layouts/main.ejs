<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Material-on-Go</title>

  <!-- Google Font -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600&display=swap" rel="stylesheet">

  <style>
    body {
      font-family: 'Poppins', sans-serif;
      margin: 0;
      background-color: #F9FAFB;
      color: #1F2937;
    }
    nav {
      background: #F59E0B;
      padding: 1rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      color: white;
    }
    a {
      text-decoration: none;
      color: inherit;
      margin-left: 1rem;
    }
    .container {
      padding: 2rem;
    }
    .card {
      background: white;
      padding: 1.5rem;
      border-radius: 8px;
      margin-bottom: 1rem;
    }
    button {
      background: #F59E0B;
      border: none;
      padding: 0.7rem 1.5rem;
      border-radius: 6px;
      color: white;
      cursor: pointer;
    }
    input {
      width: 100%;
      padding: 0.6rem;
      margin-bottom: 1rem;
    }
  </style>
</head>
<body>

  <%- body %>

</body>
</html>
