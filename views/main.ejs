<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <title>Material-on-Go</title>

  <!-- Google Font: Plus Jakarta Sans -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
    rel="stylesheet"
  >

  <style>
    :root {
      --primary: #F4B740;
      --dark: #1F2937;
      --muted: #6B7280;
      --bg: #F9FAFB;
      --card: #FFFFFF;
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: 'Plus Jakarta Sans', sans-serif;
      background-color: var(--bg);
      color: var(--dark);
    }

    /* ===== NAVBAR ===== */
    nav {
      background-color: var(--primary);
      padding: 1.2rem 2rem;
      display: flex;
      justify-content: center;
      align-items: center;
      color: white;
      border-bottom-left-radius: 24px;
      border-bottom-right-radius: 24px;
    }

    .nav-wrapper {
      width: 100%;
      max-width: 1100px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .nav-brand {
      font-size: 1.25rem;
      font-weight: 700;
      letter-spacing: 0.3px;
    }

.nav-profile {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  background: rgba(255, 255, 255, 0.25);
  padding: 0.45rem 0.9rem;
  border-radius: 18px;
  color: white;
  font-weight: 600;
  text-decoration: none;
  transition: all 0.2s ease;
}

.nav-profile:hover {
  background: rgba(255, 255, 255, 0.4);
}

.profile-img {
  width: 34px;
  height: 34px;
  border-radius: 50%;
  object-fit: cover;
  border: 2px solid white;
}

    /* ===== CONTAINER ===== */
    .container {
      padding: 3rem 2rem;
      max-width: 1100px;
      margin: auto;
    }

    /* ===== HERO ===== */
    .hero {
      text-align: center;
      margin-top: 2.5rem;
    }

    .hero h1 {
      font-size: 2.4rem;
      font-weight: 700;
      margin-bottom: 1rem;
    }

    .hero p {
      font-size: 1.05rem;
      color: var(--muted);
      max-width: 520px;
      margin: 0 auto 2rem;
    }

    .hero-actions {
      display: flex;
      justify-content: center;
      gap: 1rem;
    }

    /* ===== BUTTON ===== */
    .btn-primary {
      background-color: var(--primary);
      color: white;
      border: none;
      padding: 0.9rem 1.8rem;
      border-radius: 16px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s ease;
      text-decoration: none;
      display: inline-block;
    }

    .btn-primary:hover {
      transform: translateY(-2px);
      box-shadow: 0 10px 20px rgba(0,0,0,0.12);
    }

    .btn-outline {
      border: 2px solid var(--primary);
      background: none;
      color: var(--primary);
      padding: 0.9rem 1.8rem;
      border-radius: 16px;
      font-weight: 600;
      cursor: pointer;
      text-decoration: none;
      display: inline-block;
    }

    /* ===== FEATURES ===== */
    .features {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 2rem;
      margin-top: 4rem;
    }

    .card {
      background: var(--card);
      border-radius: 22px;
      padding: 2rem;
      box-shadow:
        8px 8px 16px rgba(0,0,0,0.08),
        -8px -8px 16px rgba(255,255,255,0.6);
      transition: all 0.2s ease;
    }

    .card:hover {
      transform: translateY(-4px);
    }

    .card h3 {
      margin-top: 0.8rem;
      margin-bottom: 0.4rem;
    }

    .card p {
      color: var(--muted);
      font-size: 0.95rem;
    }

    /* ===== FORM ===== */
    input {
      width: 100%;
      padding: 0.9rem 1rem;
      margin-bottom: 1rem;
      border-radius: 14px;
      border: 1px solid #E5E7EB;
      font-family: inherit;
    }

    input:focus {
      outline: none;
      border-color: var(--primary);
    }
  </style>
</head>

<body>

  <!-- NAVBAR -->
<nav>
  <div class="nav-wrapper">
    <div class="nav-brand">Material-on-Go</div>

    <a href="/profile" class="nav-profile">
      <img
        src="https://randomuser.me/api/portraits/men/32.jpg"
        alt="Profile"
        class="profile-img"
      >
      <span>Daniel</span>
    </a>
  </div>
</nav>


  <!-- PAGE CONTENT -->
  <%- body %>

</body>
</html>
